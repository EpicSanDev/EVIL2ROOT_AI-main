# EVIL2ROOT Trading Bot - Production Configuration

# Application Settings
FLASK_ENV=production
FLASK_DEBUG=false
SECRET_KEY=Evil2Root-SecureJWT-Key-2024-Production-Environment-12345

# Database Configuration
DB_TYPE=postgresql
DB_HOST=postgres
DB_PORT=5432
DB_NAME=evil2root_trading
DB_USER=trading_bot_user
DB_PASSWORD=TradingBot2024SecurePassword!
DATABASE_URI=postgresql+asyncpg://trading_bot_user:TradingBot2024SecurePassword!@postgres:5432/evil2root_trading

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Trading Configuration
ENABLE_LIVE_TRADING=false
INITIAL_BALANCE=100000.0
RISK_PER_TRADE=0.02
CONFIDENCE_THRESHOLD=0.65
TRADING_SYMBOLS=BTC-USD,ETH-USD,AAPL,MSFT,GOOGL,AMZN,TSLA,META,NVDA,AMD
MAX_POSITIONS=5
USE_AI_VALIDATION=true
USE_TRANSFORMER_MODEL=true

# API Keys (Placeholders - Replace with real keys)
TELEGRAM_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID_HERE
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY_HERE
CLAUDE_MODEL=anthropic/claude-3.7-sonnet
FINNHUB_API_KEY=YOUR_FINNHUB_API_KEY_HERE
ALPHAVANTAGE_API_KEY=YOUR_ALPHAVANTAGE_API_KEY_HERE
COINBASE_API_KEY=YOUR_COINBASE_API_KEY_HERE
COINBASE_API_SECRET=YOUR_COINBASE_API_SECRET_HERE
COINBASE_WEBHOOK_SECRET=YOUR_COINBASE_WEBHOOK_SECRET_HERE
BINANCE_API_KEY=YOUR_BINANCE_API_KEY_HERE
BINANCE_API_SECRET=YOUR_BINANCE_API_SECRET_HERE

# Model Configuration
MODELS_DIR=saved_models
ENABLE_AUTO_LEARNING=true
AUTO_LEARNING_CYCLE_HOURS=24

# Monitoring and Logging
LOG_LEVEL=INFO
ENABLE_MONITORING=true
ENABLE_PERFORMANCE_TRACKING=true

# Security Settings
SESSION_TIMEOUT_HOURS=2
ENABLE_RATE_LIMITING=true
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Admin Configuration
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Evil2Root_Admin_2024!
ADMIN_EMAIL=admin@evil2root.local

# Deployment Settings
WORKERS=4
WORKER_TIMEOUT=60
WORKER_CLASS=uvicorn.workers.UvicornWorker
BIND=0.0.0.0:8000

# Feature Flags
ENABLE_BACKTESTING=true
ENABLE_PAPER_TRADING=true
ENABLE_SENTIMENT_ANALYSIS=true
ENABLE_NEWS_RETRIEVAL=true
ENABLE_PLUGIN_SYSTEM=true
ENABLE_TELEGRAM_NOTIFICATIONS=true

# Performance Settings
DATA_UPDATE_INTERVAL_MINUTES=5
SIGNAL_SCAN_INTERVAL_SECONDS=60
POSITION_CHECK_INTERVAL_SECONDS=30

# Risk Management
MAX_DRAWDOWN=0.1
STOP_LOSS_PCT=0.05
TAKE_PROFIT_PCT=0.1
TRAILING_STOP_PCT=0.03